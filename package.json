{
  "name": "code-video-generator",
  "version": "0.1.0",
  "private": true,
  "description": "输入文案，实时预览并导出 15 秒竖屏视频（Next.js + Remotion）",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "verify:correctness": "node scripts/verify-correctness.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:fullscreen": "node scripts/verify-fullscreen.mjs",
    "verify:react-bits": "node scripts/verify-react-bits.mjs",
    "verify:playback-download": "node scripts/verify-playback-download.mjs",
    "verify:effects": "tsx scripts/verify-effects.mts",
    "setup:manim": "node scripts/setup-manim.mjs",
    "verify:manim": "tsx scripts/verify-manim.mts",
    "verify:demo": "tsx scripts/verify-demo.mts",
    "render:sample": "tsx scripts/render-sample.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/player": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "katex": "^0.19.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.187.0",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
